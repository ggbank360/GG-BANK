rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // GG BANK Digital Banking - Global Cloud Firestore Security Rules
    // Enables seamless cross-device synchronization between Customer,
    // Officer Desk, and Admin Portals without permission-denied errors.
    // ===============================================================

    match /{document=**} {
      allow read, write: if true;
    }

    match /accounts/{accountNumber} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /transactions/{txId} {
      allow read, write: if true;
    }

    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    match /officers/{officerId} {
      allow read, write: if true;
    }

    match /loans/{loanId} {
      allow read, write: if true;
    }

    match /beneficiaries/{beneficiaryId} {
      allow read, write: if true;
    }

    match /budgets/{budgetId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /system_health/{docId} {
      allow read, write: if true;
    }

    match /upiRequests/{requestId} {
      allow read, write: if true;
    }
  }
}
